DATABASE_URL=
LEARNING_DATABASE_URL=
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_KEY_PREFIX=cardlearn:rate-limit
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
FRONTEND_ORIGIN_REGEX=
API_BASE_URL=http://127.0.0.1:8000
RESEND_API_KEY=
RESEND_FROM=CardLearn SDGs <onboarding@resend.dev>
# false = accounts come only from the teacher's roster import (guest mode still works)
ALLOW_SELF_REGISTER=false
# e-mail domain used when a roster row has no e-mail: <student number>@<domain>
ROSTER_EMAIL_DOMAIN=nptu.edu.tw
# sign-in address printed in the account e-mail
PUBLIC_SITE_URL=https://www.cathylanguagehub.com
# Students' voice recordings (backend/recordings.py)
# AUDIO_DIR: a folder for the audio files (lab VM). Leave empty to keep the audio inside the database
# (Railway has no disk that survives a redeploy).
AUDIO_DIR=
# days a recording is kept before it is deleted (150 = one term + 30 days)
AUDIO_RETENTION_DAYS=150
# largest single recording in bytes (4 MB ≈ 17 minutes at 32 kbps)
AUDIO_MAX_BYTES=4194304
# recordings one student may send in a day
AUDIO_MAX_PER_DAY=60
# true = ask each student inside the app before the first upload. false = the school already holds
# a signed paper consent for all data on the platform (owner's decision, 2026-11-09)
AUDIO_REQUIRE_CONSENT=false
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
