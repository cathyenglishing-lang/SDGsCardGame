            "zh": "(學生的力量)"
          },
          "numbers": [],
          "scripts": {
            "A2": {
              "text": "Why should you care? Because your choices about jobs, votes and everyday habits will shape the next thirty years. Young people move this country.",
              "words": 24,
              "sentences": 3,
              "avg_sentence_words": 8.0,
              "fk_grade": 4.7,
              "speak_seconds_est": 15.2,
              "fits_20s": true,
              "provenance": "authored-replacement"
            },
            "B1": {
              "text": "This matters to you directly. Your generation will supply the engineers, the voters and the buyers of the next thirty years. Those choices will still matter long after today's politicians have gone.",
              "words": 32,
              "sentences": 3,
              "avg_sentence_words": 10.7,
              "fk_grade": 7.0,
              "speak_seconds_est": 17.5,
              "fits_20s": true,
              "provenance": "authored-replacement"
            },
            "B2": {
              "text": "It is your cohort, not mine, that will supply the engineers, voters and consumers of the coming decades. Those decisions, once taken, will simply outlive every administration currently holding office.",
